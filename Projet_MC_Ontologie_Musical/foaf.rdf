        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
    </owl:ObjectProperty>
    


    <!-- http://xmlns.com/foaf/0.1/workplaceHomepage -->

    <owl:ObjectProperty rdf:about="http://xmlns.com/foaf/0.1/workplaceHomepage">
