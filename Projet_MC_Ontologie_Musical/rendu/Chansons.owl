                                                                 <http://www.co-ode.org/ontologies/ont.owl#Album> ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.co-ode.org/ontologies/ont.owl#aArtisteDisque> ;
                                                                   owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                       owl:oneOf ( <http://www.co-ode.org/ontologies/ont.owl#Stromae>
                                                                                                 )
                                                                                     ]
                                                                 ] ;
                                                        <http://www.co-ode.org/ontologies/ont.owl#aArtisteDisque> <http://www.co-ode.org/ontologies/ont.owl#Stromae> ;
                                                        <http://www.co-ode.org/ontologies/ont.owl#aRecompense> <http://www.co-ode.org/ontologies/ont.owl#Certif_RacineCarree_4xDiamant_2014> ,
                                                                                                               <http://www.co-ode.org/ontologies/ont.owl#Victoires_AlbumChansonsAnnee_2014> ;
                                                        rdfs:comment "nécessite une fermeture des artistes du disque pour garantir l'absence de collaboration et ainsi pouvoir inférer" .


###  http://www.co-ode.org/ontologies/ont.owl#Stromae
<http://www.co-ode.org/ontologies/ont.owl#Stromae> rdf:type owl:NamedIndividual ,
                                                            <http://www.co-ode.org/ontologies/ont.owl#Musicien> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty [ owl:inverseOf <http://www.co-ode.org/ontologies/ont.owl#aArtisteDisque>
                                                                             ] ;
                                                              owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                  owl:oneOf ( <http://www.co-ode.org/ontologies/ont.owl#RacineCarree>
                                                                                            )
                                                                                ]
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty [ owl:inverseOf <http://www.co-ode.org/ontologies/ont.owl#membre>
                                                                             ] ;
                                                              owl:allValuesFrom owl:Nothing
                                                            ] ;
                                                   <http://www.co-ode.org/ontologies/ont.owl#aNationalite> "Belge" ;
                                                   <http://xmlns.com/foaf/0.1/family_name> "Van Haver" ;
                                                   <http://xmlns.com/foaf/0.1/firstName> "Paul" ;
                                                   <http://xmlns.com/foaf/0.1/gender> "Male" ;
                                                   rdfs:comment "Ajout de contraintes de fermeture (closure axioms) sur Stromae pour permettre l’inférence de SoloSeulement en OWL (hypothèse de monde ouvert) : on précise que les seuls disques auxquels Stromae participe dans ce jeu de données sont {RacineCarree} et qu’il n’est membre d’aucun groupe, afin que le reasoner puisse conclure l’absence de collaborations et d’appartenance à un groupe" .


###  http://www.co-ode.org/ontologies/ont.owl#Victoires_AlbumChansonsAnnee_2014
<http://www.co-ode.org/ontologies/ont.owl#Victoires_AlbumChansonsAnnee_2014> rdf:type owl:NamedIndividual ,
                                                                                      <http://www.co-ode.org/ontologies/ont.owl#PrixCeremonie> ;
