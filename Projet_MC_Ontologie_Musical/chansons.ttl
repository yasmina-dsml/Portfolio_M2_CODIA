@prefix : <http://www.semanticweb.org/yasmina/ontologies/chansons#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/yasmina/ontologies/chansons#> .

<http://www.semanticweb.org/yasmina/ontologies/chansons> rdf:type owl:Ontology ;
                                                          owl:imports <http://purl.org/spar/foaf> .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/yasmina/ontologies/chansons#aAdhesion
:aAdhesion rdf:type owl:ObjectProperty ;
           rdfs:domain :Groupe ;
           rdfs:range :AdhesionGroupe ;
           rdfs:comment "un groupe a des adhesions" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#aArtisteDisque
:aArtisteDisque rdf:type owl:ObjectProperty ;
                rdfs:domain :Disque ;
                rdfs:range <http://xmlns.com/foaf/0.1/Agent> ;
                rdfs:comment "rnage foaf:Agent pour musicien ou groupe" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#aCompositeur
:aCompositeur rdf:type owl:ObjectProperty ;
              rdfs:domain :Chanson ;
              rdfs:range :Musicien .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#aGenre
:aGenre rdf:type owl:ObjectProperty ;
        rdfs:domain :Chanson ;
        rdfs:range :Genre .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#aInterprete
:aInterprete rdf:type owl:ObjectProperty ;
             rdfs:domain :Chanson ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :Groupe
                                        :Musicien
                                      )
                        ] ;
             rdfs:comment "L’interprétation est faite par un musicien seul ou un groupe -> range = union des deux" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#aParolier
:aParolier rdf:type owl:ObjectProperty ;
           rdfs:domain :Chanson ;
           rdfs:range :Musicien .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#aRecompense
:aRecompense rdf:type owl:ObjectProperty ;
             rdfs:domain :Disque ;
             rdfs:range :Recompense .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#aRole
:aRole rdf:type owl:ObjectProperty ;
       rdfs:domain :Musicien ;
       rdfs:range :RoleMusical .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#contientChanson
:contientChanson rdf:type owl:ObjectProperty ;
                 rdfs:domain :Disque ;
                 rdfs:range :Chanson ;
                 rdfs:comment "Pour relier une chanson a un disque" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#dansDisque
:dansDisque rdf:type owl:ObjectProperty ;
            rdfs:domain :Chanson ;
            rdfs:range :Disque .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#groupe
:groupe rdf:type owl:ObjectProperty ;
        rdfs:domain :AdhesionGroupe ;
        rdfs:range :Groupe ;
        rdfs:comment "Une adhésion est liée à un groupe" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#laureat
:laureat rdf:type owl:ObjectProperty ;
         rdfs:domain :PrixCeremonie ;
         rdfs:range <http://xmlns.com/foaf/0.1/Agent> ;
         rdfs:comment "leaureat peut etre un musicien ou un groupe ,range -> foaf:Agent" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#membre
:membre rdf:type owl:ObjectProperty ;
        rdfs:domain :AdhesionGroupe ;
        rdfs:range :Musicien ;
        rdfs:comment "on doit créer membre au lieu d'utiliser foaf:membre car on a pas une relation directe Musicien -> Groupe d'après le sujet" ,
                     "une adhesion concerne un musicien" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#niveauCertification
:niveauCertification rdf:type owl:ObjectProperty ;
                     rdfs:domain :Certification ;
                     rdfs:range :NiveauCertification .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#roleDansGroupe
:roleDansGroupe rdf:type owl:ObjectProperty ;
                rdfs:domain :AdhesionGroupe ;
                rdfs:range :RoleMusical ;
                rdfs:comment "Dans cette adhésion, le musicien a ce rôle" .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/yasmina/ontologies/chansons#aNationalite
:aNationalite rdf:type owl:DatatypeProperty ;
              rdfs:domain :Musicien ;
              rdfs:range xsd:string ;
              rdfs:comment "foaf n'a pas de data property Nationalité donc on en crée une" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#anneCertification
:anneCertification rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Certification ;
                   rdfs:range xsd:gYear .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#anneePrix
:anneePrix rdf:type owl:DatatypeProperty ;
           rdfs:domain :PrixCeremonie ;
           rdfs:range xsd:gYear .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#categoriePrix
:categoriePrix rdf:type owl:DatatypeProperty ;
               rdfs:domain :PrixCeremonie ;
               rdfs:range xsd:string .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#debut
:debut rdf:type owl:DatatypeProperty ;
       rdfs:domain :AdhesionGroupe ;
       rdfs:range xsd:gYear ;
       rdfs:comment "debut d'adhesion dans un groupe" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#fin
:fin rdf:type owl:DatatypeProperty ;
     rdfs:domain :AdhesionGroupe ;
     rdfs:range xsd:gYear ;
     rdfs:comment "fin d'adhesion dans un groupe" ,
                  "si la personne est encore dans le groupe -> fin vide" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#nomPrix
:nomPrix rdf:type owl:DatatypeProperty ;
         rdfs:domain :PrixCeremonie ;
         rdfs:range xsd:string .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#paysCertification
:paysCertification rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Certification ;
                   rdfs:range xsd:string .


###  http://xmlns.com/foaf/0.1/family_name
<http://xmlns.com/foaf/0.1/family_name> rdfs:domain :Musicien ;
                                        rdfs:range xsd:string ;
                                        rdfs:comment "on utilise foaf:family_name pas besoin de creer une nouvelle data property" .


###  http://xmlns.com/foaf/0.1/firstName
<http://xmlns.com/foaf/0.1/firstName> rdfs:domain :Musicien ;
                                      rdfs:range xsd:string ;
                                      rdfs:comment "on utilise foaf:firstName pour le prenom des interpretes pas besoin de creer une nouvelle data property" .


###  http://xmlns.com/foaf/0.1/gender
<http://xmlns.com/foaf/0.1/gender> rdfs:domain :Musicien ;
                                   rdfs:range xsd:string .


###  http://xmlns.com/foaf/0.1/name
<http://xmlns.com/foaf/0.1/name> rdfs:domain :Groupe .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/yasmina/ontologies/chansons#AdhesionGroupe
:AdhesionGroupe rdf:type owl:Class ;
                rdfs:subClassOf owl:Thing ;
                rdfs:comment "classe intermediaire pour pouvoir modeliser musicien->membrede->groupe" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#Album
:Album rdf:type owl:Class ;
       rdfs:subClassOf :Disque .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#AuteurInterprete
:AuteurInterprete rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( :Musicien
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty [ owl:inverseOf :aInterprete
                                                                              ] ;
                                                               owl:someValuesFrom :Chanson
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty [ owl:inverseOf :aParolier
                                                                              ] ;
                                                               owl:someValuesFrom :Chanson
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf :Musicien ;
                  rdfs:comment "un AuteurInterprete est un musicien qui est parolier d’au moins une chanson et interprète d’au moins une chanson (pas nécessairement la même). La classification est inférée automatiquement via les propriétés inverses de aParolier et aInterprete" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#Certification
:Certification rdf:type owl:Class ;
               rdfs:subClassOf :Recompense .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#Chanson
:Chanson rdf:type owl:Class ;
         rdfs:subClassOf owl:Thing .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#ChansonAvecPlusieursInterpretes
:ChansonAvecPlusieursInterpretes rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( :Chanson
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :aInterprete ;
                                                                              owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                                              owl:onClass [ rdf:type owl:Class ;
                                                                                            owl:unionOf ( :Groupe
                                                                                                          :Musicien
                                                                                                        )
                                                                                          ]
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:subClassOf :Chanson ;
                                 rdfs:comment "Chansons interprétées par au moins deux interprètes (musiciens et/ou groupes),c'est une classe intermediaire pour servir la classe JamaisSolo" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#ChansonRock
:ChansonRock rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :Chanson
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :aGenre ;
                                                          owl:hasValue :Rock
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf :Chanson ;
             rdfs:comment "une instance est une ChansonRock si et seulement si c’est une chanson dont le genre contient Rock (aGenre = Rock). La classification est inférée automatiquement par le raisonneur" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#ChansonRockOuPop
:ChansonRockOuPop rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( :Chanson
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :aGenre ;
                                                               owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                    owl:oneOf ( :Pop
                                                                                                :Rock
                                                                                              )
                                                                                  ]
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf :Chanson ;
                  rdfs:comment "Les chansons Rock sont typées dans ChansonRock et comme ChansonRock est inclus dans ChansonRockOuPop, ces chansons appartiennent aussi à ChansonRockOuPop mais indirectement, sans apparaitre comme instances inferré de ChansonRockOuPop" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#CompositeurRockSeulement
:CompositeurRockSeulement rdf:type owl:Class ;
                          owl:equivalentClass [ owl:intersectionOf ( :Musicien
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty [ owl:inverseOf :aCompositeur
                                                                                      ] ;
                                                                       owl:someValuesFrom :ChansonRock
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty [ owl:inverseOf :aCompositeur
                                                                                      ] ;
                                                                       owl:allValuesFrom :ChansonRock
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ] ;
                          rdfs:subClassOf :Musicien ;
                          rdfs:comment "un CompositeurRockSeulement est un musicien qui a composé au moins une chanson Rock et dont toutes les chansons composées sont des chansons Rock." .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#DansPlusieursGroupes
:DansPlusieursGroupes rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :Musicien
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty [ owl:inverseOf :membre
                                                                                  ] ;
                                                                   owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                                   owl:onClass :AdhesionGroupe
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf :Musicien ;
                      rdfs:comment "un musicien est DansPlusieursGroupes s’il apparaît comme membre dans au moins deux adhésions de groupe" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#Disque
:Disque rdf:type owl:Class .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#DisqueAvecPlusieursMusiciens
:DisqueAvecPlusieursMusiciens rdf:type owl:Class ;
                              owl:equivalentClass [ owl:intersectionOf ( :Disque
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty :aArtisteDisque ;
                                                                           owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                                           owl:onClass :Musicien
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] ;
                              rdfs:subClassOf :Disque ;
                              rdfs:comment "Disques dont l’interprétation implique au moins deux musiciens (collaboration entre musiciens)" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#DisqueDiamantFrance
:DisqueDiamantFrance rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( :Disque
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty :aRecompense ;
                                                                  owl:someValuesFrom [ owl:intersectionOf ( :Certification
                                                                                                            [ rdf:type owl:Class ;
                                                                                                              owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                                                              owl:onProperty :niveauCertification ;
                                                                                                                              owl:hasValue :Diamant
                                                                                                                            ]
                                                                                                                            [ rdf:type owl:Restriction ;
                                                                                                                              owl:onProperty :niveauCertification ;
                                                                                                                              owl:hasValue <http://www.semanticweb.org/yasmina/ontologies/chansons#2xDiamant>
                                                                                                                            ]
                                                                                                                            [ rdf:type owl:Restriction ;
                                                                                                                              owl:onProperty :niveauCertification ;
                                                                                                                              owl:hasValue <http://www.semanticweb.org/yasmina/ontologies/chansons#3xDiamant>
                                                                                                                            ]
                                                                                                                            [ rdf:type owl:Restriction ;
                                                                                                                              owl:onProperty :niveauCertification ;
                                                                                                                              owl:hasValue <http://www.semanticweb.org/yasmina/ontologies/chansons#4xDiamant>
                                                                                                                            ]
                                                                                                                          )
                                                                                                            ]
                                                                                                            [ rdf:type owl:Restriction ;
                                                                                                              owl:onProperty :paysCertification ;
                                                                                                              owl:hasValue "France"
                                                                                                            ]
                                                                                                          ) ;
                                                                                       rdf:type owl:Class
                                                                                     ]
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf :Disque ;
                     rdfs:comment "Disques ayant reçu une certification Diamant (ou multiple) en France" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#Genre
:Genre rdf:type owl:Class ;
       rdfs:subClassOf owl:Thing .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#Groupe
:Groupe rdf:type owl:Class ;
        rdfs:subClassOf <http://xmlns.com/foaf/0.1/Group> .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#GroupeMixte
:GroupeMixte rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :Groupe
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :aAdhesion ;
                                                          owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :membre ;
                                                                               owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                                    owl:onProperty <http://xmlns.com/foaf/0.1/gender> ;
                                                                                                    owl:hasValue "Female"
                                                                                                  ]
                                                                             ]
                                                        ]
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :aAdhesion ;
                                                          owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :membre ;
                                                                               owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                                    owl:onProperty <http://xmlns.com/foaf/0.1/gender> ;
                                                                                                    owl:hasValue "Male"
                                                                                                  ]
                                                                             ]
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf :Groupe ;
             rdfs:comment "Au moins un membre homme et au moins un membre femme" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#JamaisSolo
:JamaisSolo rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :Musicien
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty [ owl:inverseOf :aInterprete
                                                                        ] ;
                                                         owl:someValuesFrom :Chanson
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty [ owl:inverseOf :aInterprete
                                                                        ] ;
                                                         owl:allValuesFrom :ChansonAvecPlusieursInterpretes
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :Musicien ;
            rdfs:comment "Musiciens qui ne sont jamais interprètes seuls : toutes les chansons qu’ils interprètent ont au moins deux interprètes" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#Musicien
:Musicien rdf:type owl:Class ;
          rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person> .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#MusicienDiamantFrançais
:MusicienDiamantFrançais rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( :Musicien
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty [ owl:inverseOf :aArtisteDisque
                                                                                     ] ;
                                                                      owl:someValuesFrom :DisqueDiamantFrance
                                                                    ]
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :aNationalite ;
                                                                      owl:hasValue "France"
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf :Musicien ;
                         rdfs:comment "Musiciens français ayant participé à un disque certifié Diamant en France, en tant qu’artistes du disque" ,
                                      "Remarque : dans les exemples demandés par le sujet, l’album Racine carrée est bien certifié 4xDiamant en France mais son artiste (Stromae) n’est pas français. Il est donc normal que cette classe puisse ne contenir aucun individu inféré avec ces seuls exemples" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#NiveauCertification
:NiveauCertification rdf:type owl:Class ;
                     rdfs:subClassOf owl:Thing .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#PrixCeremonie
:PrixCeremonie rdf:type owl:Class ;
               rdfs:subClassOf :Recompense .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#PrixVictoires
:PrixVictoires rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :PrixCeremonie
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :nomPrix ;
                                                            owl:hasValue "Victoires de la musique"
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :PrixCeremonie ;
               rdfs:comment "Prix remis lors des Victoires de la musique (identifié par nomPrix = \"Victoires de la musique\"" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#Recompense
:Recompense rdf:type owl:Class ;
            rdfs:subClassOf owl:Thing .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#RoleMusical
:RoleMusical rdf:type owl:Class ;
             rdfs:subClassOf owl:Thing .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#Single
:Single rdf:type owl:Class ;
        rdfs:subClassOf :Disque .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#SoloSeulement
:SoloSeulement rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :Musicien
                                                          [ rdf:type owl:Class ;
                                                            owl:complementOf [ rdf:type owl:Restriction ;
                                                                               owl:onProperty [ owl:inverseOf :aArtisteDisque
                                                                                              ] ;
                                                                               owl:someValuesFrom :DisqueAvecPlusieursMusiciens
                                                                             ]
                                                          ]
                                                          [ rdf:type owl:Class ;
                                                            owl:complementOf [ rdf:type owl:Restriction ;
                                                                               owl:onProperty [ owl:inverseOf :membre
                                                                                              ] ;
                                                                               owl:someValuesFrom :AdhesionGroupe
                                                                             ]
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty [ owl:inverseOf :aArtisteDisque
                                                                           ] ;
                                                            owl:someValuesFrom :Disque
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :Musicien ;
               rdfs:comment "musiciens n’appartenant à aucun groupe et n’ayant participé à aucun disque impliquant plusieurs musiciens" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#TrèsRécompensé
:TrèsRécompensé rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Musicien
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty [ owl:inverseOf :laureat
                                                                            ] ;
                                                             owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                                                             owl:onClass :PrixVictoires
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :Musicien ;
                rdfs:comment "Musiciens ayant reçu au moins trois prix aux Victoires de la musique (seul ou avec d’autres lauréats)" .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/yasmina/ontologies/chansons#AboutaGirl
:AboutaGirl rdf:type owl:NamedIndividual ,
                     :Chanson ;
            :aInterprete :Nirvana ;
            rdfs:label "About a Girl" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#Adh_Dave_FooFighters
:Adh_Dave_FooFighters rdf:type owl:NamedIndividual ,
                               :AdhesionGroupe ;
                      owl:differentFrom :Adh_Dave_Nirvana ;
                      :groupe :FooFighters ;
                      :membre :DaveGrohl ;
                      :roleDansGroupe :Chanteur ,
                                      :Guitariste ;
                      :debut "1994"^^xsd:gYear .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#Adh_Dave_Nirvana
:Adh_Dave_Nirvana rdf:type owl:NamedIndividual ,
                           :AdhesionGroupe ;
                  :groupe :Nirvana ;
                  :membre :DaveGrohl ;
