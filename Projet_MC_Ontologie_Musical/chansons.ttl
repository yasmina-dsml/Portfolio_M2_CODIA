###  http://www.semanticweb.org/yasmina/ontologies/chansons#RacineCarree
:RacineCarree rdf:type owl:NamedIndividual ,
                       :Album ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :aArtisteDisque ;
                         owl:allValuesFrom [ rdf:type owl:Class ;
                                             owl:oneOf ( :Stromae
                                                       )
                                           ]
                       ] ;
              :aArtisteDisque :Stromae ;
              :aRecompense :Certif_RacineCarree_4xDiamant_2014 ,
                           :Victoires_AlbumChansonsAnnee_2014 ;
              rdfs:comment "nécessite une fermeture des artistes du disque pour garantir l'absence de collaboration et ainsi pouvoir inférer" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#Rock
:Rock rdf:type owl:NamedIndividual ,
               :Genre ;
      rdfs:label "Rock" .


