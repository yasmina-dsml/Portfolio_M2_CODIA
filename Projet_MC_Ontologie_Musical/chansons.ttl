###  http://www.semanticweb.org/yasmina/ontologies/chansons#KurtCobain
:KurtCobain rdf:type owl:NamedIndividual ,
                     :Musicien ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty [ owl:inverseOf :aCompositeur
                                      ] ;
                       owl:allValuesFrom [ rdf:type owl:Class ;
                                           owl:oneOf ( :Lithium
                                                       :SmellsLikeTeenSpirit
                                                     )
                                         ]
                     ] ;
            :aNationalite "USA" ;
            <http://xmlns.com/foaf/0.1/family_name> "Cobain" ;
            <http://xmlns.com/foaf/0.1/firstName> "Kurt" ;
            <http://xmlns.com/foaf/0.1/gender> "Male" ;
            rdfs:comment "toutes les chansons dont Kurt est compositeur ∈ {Lithium, SmellsLikeTeenSpirit} pour pouvoir inférer CompositeurRockSeulement sinon le reasoner ne peut pas conclure \"only rock\"" ;
            rdfs:label "Kurt Cobain" .


