:ShirleyManson rdf:type owl:NamedIndividual ,
                        :Musicien ;
               :aNationalite "United Kingdom" ;
               <http://xmlns.com/foaf/0.1/family_name> "Manson" ;
               <http://xmlns.com/foaf/0.1/firstName> "Shirley" ;
               <http://xmlns.com/foaf/0.1/gender> "Female" ;
               rdfs:label "Shirley Manson" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#SmellsLikeTeenSpirit
:SmellsLikeTeenSpirit rdf:type owl:NamedIndividual ,
                               :Chanson ;
                      :aCompositeur :KurtCobain ;
                      :aGenre :Rock ;
                      :aInterprete :KurtCobain ,
                                   :Nirvana ;
                      :aParolier :KurtCobain ;
                      rdfs:label "Smells Like Teen Spirit" .


###  http://www.semanticweb.org/yasmina/ontologies/chansons#Stromae
:Stromae rdf:type owl:NamedIndividual ,
                  :Musicien ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty [ owl:inverseOf :aArtisteDisque
                                   ] ;
                    owl:allValuesFrom [ rdf:type owl:Class ;
                                        owl:oneOf ( :RacineCarree
                                                  )
                                      ]
                  ] ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty [ owl:inverseOf :membre
                                   ] ;
                    owl:allValuesFrom owl:Nothing
                  ] ;
         :aNationalite "Belge" ;
         <http://xmlns.com/foaf/0.1/family_name> "Van Haver" ;
         <http://xmlns.com/foaf/0.1/firstName> "Paul" ;
         <http://xmlns.com/foaf/0.1/gender> "Male" ;
         rdfs:comment "Ajout de contraintes de fermeture (closure axioms) sur Stromae pour permettre l’inférence de SoloSeulement en OWL (hypothèse de monde ouvert) : on précise que les seuls disques auxquels Stromae participe dans ce jeu de données sont {RacineCarree} et qu’il n’est membre d’aucun groupe, afin que le reasoner puisse conclure l’absence de collaborations et d’appartenance à un groupe" ;
         rdfs:label "Stromae" .


